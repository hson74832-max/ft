{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "verify:motion": "esbuild scripts/motion-pipeline.ts --bundle --platform=node --format=cjs --outfile=.test-artifacts/motion-pipeline.cjs && node .test-artifacts/motion-pipeline.cjs",
    "verify:duels": "esbuild scripts/duel-regression.ts --bundle --platform=node --format=cjs --outfile=.test-artifacts/duel-regression.cjs && node .test-artifacts/duel-regression.cjs",
    "verify:gameplay": "esbuild scripts/gameplay-regression.ts --bundle --platform=node --format=cjs --outfile=.test-artifacts/gameplay-regression.cjs && node .test-artifacts/gameplay-regression.cjs",
    "verify:perception": "esbuild scripts/perception-regression.ts --bundle --platform=node --format=cjs --outfile=.test-artifacts/perception-regression.cjs && node .test-artifacts/perception-regression.cjs",
    "verify:referee": "esbuild scripts/referee-regression.ts --bundle --platform=node --format=cjs --outfile=.test-artifacts/referee-regression.cjs && node .test-artifacts/referee-regression.cjs",
    "verify:physics": "esbuild scripts/physics-regression.ts --bundle --platform=node --format=cjs --outfile=.test-artifacts/physics-regression.cjs && node .test-artifacts/physics-regression.cjs",
    "verify:scenarios": "esbuild scripts/scenario-regression.ts --bundle --platform=node --format=cjs --outfile=.test-artifacts/scenario-regression.cjs && node .test-artifacts/scenario-regression.cjs",
    "verify:tactics": "esbuild scripts/tactics-test.ts --bundle --platform=node --format=cjs --outfile=.test-artifacts/tactics-test.cjs && node .test-artifacts/tactics-test.cjs"
  },
  "dependencies": {
    "@types/three": "^0.186.0",
    "clsx": "2.1.1",
    "lucide-react": "^1.61.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0"
  }
}
